{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "modelquad",
            "args": [
              "hook-pending",
              "claude"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*modelquad_delegate",
        "hooks": [
          {
            "type": "command",
            "command": "modelquad",
            "args": [
              "hook-review",
              "claude"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  },
  "modules": [
    "./quota-band.tsx"
  ]
}
