{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__plugin_modelquad_review__delegate|mcp__modelquad__delegate",
        "hooks": [
          {
            "type": "command",
            "command": "modelquad",
            "args": [
              "hook-review",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "modelquad",
            "args": [
              "hook-review",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "modelquad",
            "args": [
              "hook-review",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
